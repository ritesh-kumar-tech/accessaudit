# --- Server (never exposed to the browser) ---
PORT=3000

# Supabase project URL and service role key, used only by the Express server
# to verify user sessions and write scan records (bypasses RLS). Get these
# from Supabase Dashboard -> Project Settings -> API. The "secret" key
# (sb_secret_...) is the service role key under Supabase's new API key names.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Client (bundled into the browser, must be prefixed with VITE_) ---
# Same project URL plus the public "anon"/"publishable" key. Safe to expose
# client-side; Row Level Security policies in supabase/migrations/ enforce
# access control.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Only needed if you want Claude/the server to run SQL migrations directly
# instead of pasting them into the Supabase SQL Editor yourself. Use the
# session-mode pooler connection string from Supabase Dashboard -> Project
# Settings -> Database, with the real database password filled in. Put the
# real value in .env only -- never here.
DIRECT_URL=
